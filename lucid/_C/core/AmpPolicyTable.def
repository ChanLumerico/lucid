LUCID_AMP_ROW(conv1d,                       LOWER,  LOWER)
LUCID_AMP_ROW(conv2d,                       LOWER,  LOWER)
LUCID_AMP_ROW(conv3d,                       LOWER,  LOWER)
LUCID_AMP_ROW(conv_transpose1d,             LOWER,  LOWER)
LUCID_AMP_ROW(conv_transpose2d,             LOWER,  LOWER)
LUCID_AMP_ROW(conv_transpose3d,             FP32,   LOWER)
LUCID_AMP_ROW(cosh,                         FP32,   KEEP)
LUCID_AMP_ROW(cosine_embedding_loss,        FP32,   FP32)
