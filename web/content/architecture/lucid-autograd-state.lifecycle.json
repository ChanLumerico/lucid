      { "id": "main-life", "label": "Record to .grad", "focus": ["leaf", "recorded", "walking", "release", "done"], "note": "A leaf used in an op builds a graph; backward fills the grads, then the graph is released." },
      { "id": "keep-graph", "label": "Keeping the graph", "focus": ["release", "kept", "walking"], "note": "Only a graph kept with retain_graph=True can run backward again." },
      { "id": "recovery", "label": "Version mismatch", "focus": ["walking", "mismatch", "recorded"], "note": "An in-place change to a saved tensor stops the walk; re-running forward recovers." },
      { "id": "no-record", "label": "Nothing recorded", "focus": ["leaf", "nograd"], "note": "With GradMode off (no_grad, inference_mode) the kernels skip node creation entirely." }
    ]
  },
  "lanes": [
    { "id": "main", "label": "Main path" },
    { "id": "waiting", "label": "Graph kept" },
    { "id": "exceptions", "label": "Recovery loop" },
    { "id": "terminal", "label": "Not recorded" }
  ],
  "states": [
    { "id": "leaf", "type": "start", "label": "Leaf tensor", "sublabel": "requires_grad=True", "lane": "main", "col": 0, "step": "01", "tag": "AccumulateGrad" },
