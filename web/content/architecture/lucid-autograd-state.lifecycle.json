    { "id": "done", "type": "success", "label": ".grad final", "sublabel": "root grad_fn cleared", "lane": "main", "col": 4, "step": "05", "tag": "after hooks" },
    { "id": "kept", "type": "waiting", "label": "Graph kept", "sublabel": "retain_graph=True", "lane": "waiting", "col": 1, "tag": "reusable" },
    { "id": "mismatch", "type": "failure", "label": "VersionMismatch", "sublabel": "in-place after save", "lane": "exceptions", "col": 0, "tag": "recoverable" },
